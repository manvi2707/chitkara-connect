# =============================================
# server/.env — Copy this to .env and fill values
# =============================================

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/chitkara-connect?retryWrites=true&w=majority

# JWT secret — use a long random string (IMPORTANT: set this in Render env vars!)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long

# Frontend URL (your Netlify URL — needed for CORS)
CLIENT_URL=https://your-app.netlify.app

# Cloudinary (for photo uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Nodemailer (for email notifications)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Groq API (for ChitkaraBot AI)
GROQ_API_KEY=gsk_your_groq_api_key